<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="AIIntegration" constructor="ApiFieldMapper" version="0.0.20" display-name-key="ApiFieldMapper" description-key="ApiFieldMapper description" control-type="standard">
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <!-- <external-service-usage enabled="true">
      <domain>crmintstg.tdra.gov.ae</domain>
    </external-service-usage> -->
    <type-group name="textValues">
      <type>SingleLine.Text</type>
      <type>SingleLine.TextArea</type>
      <type>Multiple</type>
    </type-group>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="BoundField" display-name-key="BoundField_Display_Key" description-key="BoundField to bound put the PCF on top of " of-type="SingleLine.Text" usage="bound" required="true" />
    <property name="inputValue" display-name-key="Input_Value_Display_Key" description-key="Input_Value_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="caseDetails" display-name-key="Case_Details_Display_Key" description-key="Case details used to generate the AI prompt" of-type-group="textValues" usage="input" required="false" />
    <property name="providerName" display-name-key="Provider_Name_Display_Key" description-key="Service provider used to generate the AI prompt. Option sets are sent by label." of-type="OptionSet" usage="input" required="false" />
    <property name="providerResponse" display-name-key="Provider_Response_Display_Key" description-key="Service provider response used to generate the AI prompt" of-type-group="textValues" usage="input" required="false" />
    <property name="apiEndpoint" display-name-key="Api_Endpoint_Display_Key" description-key="Api_Endpoint_Desc_Key" of-type="SingleLine.URL" usage="input" required="true" />
    <property name="requestMethod" display-name-key="Request_Method_Display_Key" description-key="Request_Method_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="requestTemplate" display-name-key="Request_Template_Display_Key" description-key="Request_Template_Desc_Key" of-type="Multiple" usage="input" required="false" />
    <property name="headersJson" display-name-key="Headers_Json_Display_Key" description-key="Headers_Json_Desc_Key" of-type="Multiple" usage="input" required="false" />
    <property name="apiVersion" display-name-key="Api_Version_Display_Key" description-key="Api_Version_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="includeLegalNoteText" display-name-key="Include_Legal_Note_Text_Display_Key" description-key="Include_Legal_Note_Text_Desc_Key" of-type="TwoOptions" usage="input" required="false" />
    <property name="isdevleopment" display-name-key="Is_Development" description-key="Used to specify whether you want to display the UI in the Dev mode or not" of-type="Enum" usage="input" required="false" default-value="false">
      <value name="Production" display-name-key="Production" description-key="Hides returned JSON span and optionset numbers">false</value>
      <value name="Development" display-name-key="Development" description-key="Shows returned JSON span and optionset numbers">true</value>
    </property>
    <property name="includeLegalNotes" display-name-key="Include_Legal_Notes_Display_Key" description-key="Controls whether returned legal notes are created and associated to the Case" of-type="Enum" usage="input" required="false" default-value="false">
      <value name="DoNotInclude" display-name-key="Do_Not_Include_Legal_Notes" description-key="Do not create or associate returned legal notes">false</value>
      <value name="Include" display-name-key="Include_Legal_Notes" description-key="Create and associate returned legal notes when the AI decision is Assess case">true</value>
    </property>
    <property name="isBpfHandled" display-name-key="Is_BPF_Handled" description-key="Controls whether the PCF checks the current Business Process Flow stage before running" of-type="Enum" usage="input" required="false" default-value="false">
      <value name="No" display-name-key="No" description-key="Do not check the Business Process Flow stage">false</value>
      <value name="Yes" display-name-key="Yes" description-key="Check the Business Process Flow stage before enabling the PCF">true</value>
    </property>
    <property name="bpfEntityName" display-name-key="BPF_Entity_Name_Display_Key" description-key="Business Process Flow table logical name. Accepts a single input." of-type="SingleLine.Text" usage="input" required="false" />
    <property name="bpfCaseLookupFieldName" display-name-key="BPF_Case_Lookup_Field_Name_Display_Key" description-key="Business Process Flow lookup field logical name to Case. Accepts a single input." of-type="SingleLine.Text" usage="input" required="false" />
    <property name="allowedBpfStageNames" display-name-key="Allowed_BPF_Stage_Names_Display_Key" description-key="Business Process Flow stage names where the PCF is allowed to run. Accepts comma-separated inputs or a single input." of-type-group="textValues" usage="input" required="false" />
    <property name="resultPath" display-name-key="Result_Path_Display_Key" description-key="Result_Path_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" />
    <!-- Unused behavior flags; kept commented to reduce the configuration shown in maker UI.
    <property name="autoRunOnLoad" display-name-key="Auto_Run_On_Load_Display_Key" description-key="Auto_Run_On_Load_Desc_Key" of-type="TwoOptions" usage="input" required="false" />
    <property name="triggerOnValueChange" display-name-key="Trigger_On_Value_Change_Display_Key" description-key="Trigger_On_Value_Change_Desc_Key" of-type="TwoOptions" usage="input" required="false" />
    -->
    <property name="decisionByAI" display-name-key="Decision_By_AI_Display_Key" description-key="Decision_By_AI_Desc_Key" of-type="OptionSet" usage="bound" required="false" />
    <property name="feedbackByAI" display-name-key="Feedback_By_AI_Display_Key" description-key="Feedback_By_AI_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="customerCallSuggestionInstructionsByAI" display-name-key="Customer_Call_Suggestion_Instructions_By_AI_Display_Key" description-key="Customer_Call_Suggestion_Instructions_By_AI_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="validationByAI" display-name-key="Validation_By_AI_Display_Key" description-key="Validation_By_AI_Desc_Key" of-type="OptionSet" usage="bound" required="false" />
    <property name="invalidReason" display-name-key="Invalid_Reason_Display_Key" description-key="Invalid_Reason_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="closedInFavorOf" display-name-key="Closed_In_Favor_Of_Display_Key" description-key="Closed_In_Favor_Of_Desc_Key" of-type="OptionSet" usage="bound" required="false" />
    <property name="routeToSPReasons" display-name-key="Route_To_SP_Reasons_Display_Key" description-key="Route_To_SP_Reasons_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="assessDisputeComment" display-name-key="Assess_Dispute_Comment_Display_Key" description-key="Comment field populated only when the AI decision is Assess Dispute" of-type="Multiple" usage="bound" required="false" />
    <property name="routeToServiceProviderComment" display-name-key="Route_To_Service_Provider_Comment_Display_Key" description-key="Comment field populated only when the AI decision is Route to Service Provider" of-type="Multiple" usage="bound" required="false" />
    <property name="routeToDepartmentComment" display-name-key="Route_To_Department_Comment_Display_Key" description-key="Comment field populated only when the AI decision is Route to Department" of-type="Multiple" usage="bound" required="false" />
    <property name="escalateToLeadComment" display-name-key="Escalate_To_Lead_Comment_Display_Key" description-key="Comment field populated only when the AI decision is Escalate to Lead" of-type="Multiple" usage="bound" required="false" />
    <property name="suggestedComment" display-name-key="Suggested_Comment_Display_Key" description-key="Suggested_Comment_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="suggestedDecision" display-name-key="Suggested_Decision_Display_Key" description-key="Suggested_Decision_Desc_Key" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="legalNotesJson" display-name-key="Legal_Notes_Json_Display_Key" description-key="Legal_Notes_Json_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="correlationId" display-name-key="Correlation_Id_Display_Key" description-key="Correlation_Id_Desc_Key" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="resultText" display-name-key="Result_Text_Display_Key" description-key="Result_Text_Desc_Key" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="resultJson" display-name-key="Result_Json_Display_Key" description-key="Result_Json_Desc_Key" of-type="Multiple" usage="bound" required="false" />
    <property name="statusText" display-name-key="Status_Text_Display_Key" description-key="Status_Text_Desc_Key" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="lastRunOn" display-name-key="Last_Run_On_Display_Key" description-key="Last_Run_On_Desc_Key" of-type="DateAndTime.DateAndTime" usage="bound" required="false" />
    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/ApiFieldMapper.css" order="1" />
      <!-- <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" /> -->
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <resx path="strings/ApiFieldMapper.1033.resx" version="1.0.0" />
      -->
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>